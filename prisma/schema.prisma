generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(50)
  email    String @unique @db.VarChar(80)
  password String @db.VarChar(64)
}

model Login {
  id      Int      @id @default(autoincrement())
  email   String   @db.VarChar(80)
  date    DateTime @default(now())
  success Boolean
}

model Client {
  id                 Int         @id @default(autoincrement())
  name               String      @db.VarChar(100)
  contactPersonName  String?     @db.VarChar(50)
  contactPersonEmail String?     @db.VarChar(100)
  contactPersonPhone String?     @db.VarChar(15)
  keys               ClientKey[]
}

model ClientKey {
  id        Int       @id @default(autoincrement())
  clientId  Int
  client    Client    @relation(fields: [clientId], references: [id])
  uniqueKey String    @unique @default(uuid()) @db.Uuid
  keyUsedAt DateTime?
  createdAt DateTime  @default(now())
  answers   Answer[]
}

model QuestionType {
  id        Int        @id @default(autoincrement())
  label     String     @db.VarChar(30)
  questions Question[]
}

model Stage {
  id        Int        @id @default(autoincrement())
  label     String     @db.VarChar(50)
  questions Question[]
}

model Question {
  id             Int          @id @default(autoincrement())
  questionTypeId Int
  questionType   QuestionType @relation(fields: [questionTypeId], references: [id])
  stageId        Int?
  stage          Stage?       @relation(fields: [stageId], references: [id])
  question       String       @db.VarChar(255)
  isVisible      Boolean      @default(true)
  created        DateTime     @default(now())
  lastUpdated    DateTime     @updatedAt
  options        Option[]
  answers        Answer[]
}

model Option {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])
  option     String   @db.VarChar(255)
  value      Int      @default(0)
  answers    Answer[]
}

model Answer {
  id          Int       @id @default(autoincrement())
  clientKeyId Int
  clientKey   ClientKey @relation(fields: [clientKeyId], references: [id])
  questionId  Int
  question    Question  @relation(fields: [questionId], references: [id])
  optionId    Int
  option      Option    @relation(fields: [optionId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([clientKeyId, questionId])
}
